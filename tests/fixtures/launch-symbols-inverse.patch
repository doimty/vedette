+      - name: Upload deb packages
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
+        with:
+          name: vedette-${{ matrix.scheme }}-packages
+          path: packages/*.deb
+          if-no-files-found: error
+
+      # Theos generates per-architecture dSYMs at link time before stripping.
+      # Collect only project products after the installable deb is uploaded.
+      - name: Collect debug symbols
+        run: |
+          set -o pipefail
+          python3 -B ci/collect_symbols.py --objects .theos/obj --objects vedetteprefs/.theos/obj --objects nicectl/.theos/obj --out symbols --require
+
+      - name: Verify debug symbols against the package
+        run: |
+          set -o pipefail
+          python3 -B ci/verify_symbols.py symbols --package-root /tmp/vedette-package --package-prefix "$PACKAGE_PREFIX" --manifest symbols/manifest.json 2>&1 | tee symbols/verify.log
+
+      - name: Upload debug symbols
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
+        with:
+          name: vedette-${{ matrix.scheme }}-dsym
+          path: symbols/
+          include-hidden-files: true
+          retention-days: 90
+          if-no-files-found: error
