+id valueForProcessResourceRuleKeyWithPrefs(NSString *identifier,
+                                           NSString *key,
+                                           id defaultValue,
+                                           VDTConfigType type,
+                                           NSString *sectionKey,
+                                           NSDictionary *prefs){
+    if (![identifier isKindOfClass:[NSString class]] || identifier.length == 0 ||
