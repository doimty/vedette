+    if (error == ENOENT && !removal) return 0;
+    if (error) return error;
+    if (!removal) {
+        error = VDTNiceStoreRemove(&store, VDT_NICE_REQUEST);
+        VDTNiceStoreClose(&store);
+        if (!error && notify_post(PREFS_CHANGED_NN.UTF8String) != NOTIFY_STATUS_OK) return EIO;
+        return error;
