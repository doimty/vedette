+    } else if (VDTSpringBoardPathMatches(path.UTF8String) && rules[@"1:SpringBoard"]) {
+        name = @VDT_SPRINGBOARD_RULE_NAME;
+        rule = VDTNiceEffectiveRuleFromRules(name, type, nil, rules);
+    } else if (appPath) {
