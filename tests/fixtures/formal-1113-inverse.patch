+        if (error == ENOENT) error = 0;
+        if (error) break;
+        double now = monotonic(); if (now < start || now - start >= 8.0) break;
+        struct timespec interval = {.tv_sec=0, .tv_nsec=100000000}; nanosleep(&interval, NULL);
