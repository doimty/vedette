#!/bin/bash
set -eu
# Upgrade keeps the journal; removal must receive the checked recovery receipt.
case "${1:-}" in
    remove|deconfigure)
        ctl=/var/jb/usr/libexec/vedette-nicectl
        if [ ! -x "$ctl" ]; then
            echo 'Vedette: nice restoration tool missing; removal stopped.' >&2
            exit 1
        fi
        "$ctl" restore-for-removal
        ;;
esac
exit 0
