#!/bin/bash
set -u
# Rootless counterpart of the RootHide resume gate. Never discard the journal,
# and never leave dpkg half-configured because of an advisory control step.
ctl=/var/jb/usr/libexec/vedette-nicectl
if [ ! -x "$ctl" ]; then
    echo 'Vedette: nice control tool missing; continuing package configuration.' >&2
else
    "$ctl" resume || echo "Vedette: nice resume failed (errno=$?); continuing package configuration." >&2
fi

echo "Killing runningboardd..."
killall -9 runningboardd || true
exit 0
