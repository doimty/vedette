#!/bin/bash
set -eu
# Upgrades preserve the journal for the new runtime. Actual removal must wait
# for an authenticated, quiesced runtime receipt; failure leaves records intact.
case "${1:-}" in
    remove|deconfigure)
        if ! command -v jbroot >/dev/null 2>&1; then
            echo 'Vedette: cannot resolve roothide path; removal stopped.' >&2
            exit 1
        fi
        ctl="$(jbroot)/usr/libexec/vedette-nicectl"
        if [ ! -x "$ctl" ]; then
            echo 'Vedette: nice restoration tool missing; removal stopped.' >&2
            exit 1
        fi
        "$ctl" restore-for-removal
        ;;
esac
exit 0
